# Node 24+; local defaults shown below. Docker Compose supplies absolute paths.
BLOG_DATA_DIR=./data/blog
BLOG_UPLOAD_DIR=./uploads/blog
# Upload bytes: default 10 MiB; hard ceiling 25 MiB. Dimensions: 24 MP / 12000 px per side.
BLOG_UPLOAD_MAX_BYTES=10485760

# Server-only credentials: distinct random secrets of at least 32 characters.
# Empty configuration disables the internal API (503); public blog still works.
# Generate each independently, e.g. openssl rand -hex 32. Never use NEXT_PUBLIC_*.
BLOG_API_READ_TOKEN=
BLOG_API_WRITE_TOKEN=
BLOG_API_PUBLISH_TOKEN=

# Human administrator; no NEXT_PUBLIC_* credentials. Access fails closed if unset.
BLOG_ADMIN_LOGIN=
# Generate interactively: npm run admin:hash-password (password is not echoed).
BLOG_ADMIN_PASSWORD_HASH=
# Exact browser origin. HTTPS required except localhost/127.0.0.1/[::1].
# Local example: http://localhost:3000 (use that exact host in the browser).
BLOG_ADMIN_ORIGIN=
